{
    "name": "contexia-web-app",
    "version": 2,
    "outputDirectory": ".",
    "redirects": [
        {
            "source": "/",
            "destination": "/landing.html",
            "permanent": false
        },
        {
            "source": "/login",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/reset-password",
            "destination": "/reset-password.html",
            "permanent": false
        },
        {
            "source": "/app/login",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/app/login.html",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/wizard/login",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/wizard/login/",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/wizard/dashboard",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/wizard/dashboard/",
            "destination": "/login.html",
            "permanent": false
        },
        {
            "source": "/app",
            "destination": "/app/bunker",
            "permanent": false
        },
        {
            "source": "/wizard/",
            "destination": "/wizard",
            "permanent": false
        },
        {
            "source": "/logout",
            "destination": "/logout.html",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/app",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app/:path*",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app-admin/:path*",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/flujo-detalle",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/flujo-detalle.html",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/renta-natural",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/renta-natural.html",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/icons/:path*",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
                { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" }
            ]
        },
        {
            "source": "/assets/img/:path*",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
                { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/(login|logout|crear-empresa|landing|reset-password).html",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
                { "key": "CDN-Cache-Control", "value": "no-store" },
                { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/landing",
            "destination": "/landing.html"
        },
        {
            "source": "/api/v1/:path*",
            "destination": "https://antigravity-app-production-175a.up.railway.app/api/v1/:path*"
        },
        {
            "source": "/privacy",
            "destination": "https://antigravity-app-production-175a.up.railway.app/privacy"
        },
        {
            "source": "/terms",
            "destination": "https://antigravity-app-production-175a.up.railway.app/terms"
        },
        {
            "source": "/data-deletion",
            "destination": "https://antigravity-app-production-175a.up.railway.app/data-deletion"
        },
        {
            "source": "/app/overview",
            "destination": "/app/overview.html"
        },
        {
            "source": "/app/fiscal",
            "destination": "/app/fiscal.html"
        },
        {
            "source": "/app/radar",
            "destination": "/app/radar.html"
        },
        {
            "source": "/app/patrimonio",
            "destination": "/app/patrimonio.html"
        },
        {
            "source": "/app/config",
            "destination": "/app/config.html"
        },
        {
            "source": "/app/acerca",
            "destination": "/app/acerca.html"
        },
        {
            "source": "/app/overview-v2",
            "destination": "/app/overview-v2.html"
        },
        {
            "source": "/app/fiscal-v2",
            "destination": "/app/fiscal-v2.html"
        },
        {
            "source": "/app/radar-v2",
            "destination": "/app/radar-v2.html"
        },
        {
            "source": "/app/patrimonio-v2",
            "destination": "/app/patrimonio-v2.html"
        },
        {
            "source": "/app/acerca-v2",
            "destination": "/app/acerca-v2.html"
        },
        {
            "source": "/flujo-detalle",
            "destination": "/flujo-detalle.html"
        },
        {
            "source": "/app/flujo-detalle",
            "destination": "/flujo-detalle.html"
        },
        {
            "source": "/flujo-detalle-v2",
            "destination": "/flujo-detalle-v2.html"
        },
        {
            "source": "/conectar-datos-v2",
            "destination": "/conectar-datos-v2.html"
        },
        {
            "source": "/app/bunker",
            "destination": "/app/bunker.html"
        },
        {
            "source": "/app/dashboard-assets/:path*",
            "destination": "/app-admin/dashboard-assets/:path*"
        },
        {
            "source": "/_next/:path*",
            "destination": "/_next/:path*"
        },
        {
            "source": "/app/:path*",
            "destination": "/404.html"
        },
        {
            "source": "/crear-empresa",
            "destination": "/crear-empresa.html"
        },
        {
            "source": "/crear-empresa-wizard",
            "destination": "/crear-empresa-wizard.html"
        },
        {
            "source": "/renta-natural",
            "destination": "/renta-natural.html"
        },
        {
            "source": "/app/assets/:path*",
            "destination": "/app/assets/:path*"
        },
        {
            "source": "/wizard/api/:path*",
            "destination": "https://contexia-wizard.vercel.app/wizard/api/:path*"
        },
        {
            "source": "/wizard/:path*",
            "destination": "https://contexia-wizard.vercel.app/wizard/:path*"
        },
        {
            "source": "/wizard",
            "destination": "https://contexia-wizard.vercel.app/wizard"
        }
    ]
}
