# Hermes->Manus poller — copy to .env and fill in.
# The poller stays inert (claims nothing) until MANUS_API_KEY is set.

# Manus API key: Manus webapp -> Settings -> API Integration -> Create API Key.
# Shown only once. Never commit this file.
MANUS_API_KEY=

# Optional: file Manus tasks under one of the CTX-* projects.
MANUS_PROJECT_ID=

# Optional overrides (defaults are correct for production).
# MANUS_API_BASE_URL=https://api.manus.ai
# MANUS_AGENT_PROFILE=manus-1.6
# CONTEXIA_API_URL=https://antigravity-app-production-175a.up.railway.app

# Only needed if /api/v1/sell-machine/tasks/* ever gets auth-gated (open today).
CONTEXIA_JWT_SECRET=

# Max operator tasks claimed per tick.
MAX_TASKS_PER_TICK=3
