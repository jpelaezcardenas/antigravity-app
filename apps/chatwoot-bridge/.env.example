# Chatwoot
CHATWOOT_URL=http://localhost:3020
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# The real Meta-linked WhatsApp inbox (Channel::Whatsapp) this account's replies must be sent
# through — NOT a Channel::Api test/injection inbox, which has no Meta credentials and cannot
# deliver (taty-whatsapp-renta-sales-capability, Stage 5).
CHATWOOT_WHATSAPP_INBOX_ID=

# Durable inbox poller (whatsapp-durable-inbox) — pulls persisted webhook events from the
# backend and injects them into Chatwoot as incoming messages. Off by default so the bridge
# still works standalone before it's fully configured.
INBOX_POLLER_ENABLED=false
INBOX_POLL_INTERVAL_SECONDS=5.0

# Hermes Gateway (local, OpenAI-compatible chat completions — see design.md decision 1)
HERMES_GATEWAY_URL=http://localhost:8642
HERMES_MODEL=taty-v1
HERMES_API_KEY=

# Contexia backend
CONTEXIA_API_URL=http://127.0.0.1:8080/api/v1
CONTEXIA_JWT_SECRET=

# HITL / conversation behavior
PAUSE_LABEL=bot_off
MAX_HISTORY=10

# Webhook auth (shared token, checked via query param or X-Webhook-Token header)
WEBHOOK_TOKEN=

PORT=8090

# Reserved for phase 2 (audio transcription), unused today.
LOCAL_WHISPER_URL=

# --- Outbound voice notes (voicebox-local-voice-adoption) --------------------
# Ships OFF. VoiceBox runs on the local inference node, which does not exist yet;
# on a CPU-only host synthesis takes 3-5 minutes per phrase. With this false the
# bridge behaves exactly as it did before the feature landed.
VOICE_ENABLED=false

# Local VoiceBox REST API. Never a public address - synthesis stays on-prem so
# the client's text, the model and the cloned voice never leave this machine.
VOICEBOX_URL=http://127.0.0.1:17493

# Cloned-voice profile id (from GET /profiles). Empty = voice unavailable; never
# guessed, because a wrong id speaks in a different voice. Differs per machine.
VOICEBOX_PROFILE_ID=

# VoiceBox request fields. Both of these override dangerous API defaults:
# language defaults to "en", and model_size defaults to "1.7B" - the model
# Phase 0 measured at 30-60 minutes per phrase on CPU.
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=0.6B
VOICEBOX_LANGUAGE=es
VOICEBOX_TIMEOUT_SECONDS=120

# Shared secret for the backend's /internal/* surface (same key the Siigo and
# Gmail pollers use). Empty fails closed: the backend answers 503.
INTERNAL_API_KEY=
