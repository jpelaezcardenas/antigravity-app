# Hermes->HubSpot sync poller — copy to .env and fill in.
# The poller stays inert (touches nothing) until both HUBSPOT_ACCESS_TOKEN and
# SUPABASE_SERVICE_ROLE_KEY are set. Never commit the filled-in .env.

# HubSpot Private App: HubSpot webapp -> Settings -> Integrations -> Private Apps -> Create.
# Scopes needed: crm.objects.contacts (read/write), crm.objects.deals (read/write),
# crm.objects.companies (read/write). Shown only once.
HUBSPOT_ACCESS_TOKEN=

# Optional override (default is correct for production).
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# HUBSPOT_DEAL_PIPELINE=default

# Supabase project (same project the backend uses) — service-role key, NOT the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max crm_leads/b2b_clients rows synced per tick.
MAX_RECORDS_PER_TICK=50
