# GLM 5.2 API Configuration
GLM_API_KEY=sk_xxx_your_zhipu_key_xxx

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=xxx_your_bot_token_xxx

# Railway Configuration (auto-injected)
DATABASE_URL=postgresql://...
SUPABASE_URL=...
SUPABASE_ANON_KEY=...

# Hermes Gateway
HERMES_API_TOKEN=hermes-dev-token-123
HERMES_GATEWAY_PORT=8644

# Feature Flags
DEBUG=false
LOG_LEVEL=INFO

# Meta WhatsApp Cloud API.
# Inbound webhook is public at contexia.online/api/v1/channels/whatsapp/webhook
# (vercel.json rewrite -> Railway). No tunnel or DNS delegation required.
# All four values below fail closed: empty rejects every request, never a default.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xxx_generate_with_openssl_rand_hex_32_xxx
WHATSAPP_APP_SECRET=xxx_meta_app_secret_used_for_X-Hub-Signature-256_xxx
WHATSAPP_PHONE_NUMBER_ID=xxx_your_phone_number_id_xxx
WHATSAPP_TOKEN=xxx_your_meta_system_user_token_xxx

# Meta social webhooks (Instagram/Facebook -> Social Content Ops).
META_WEBHOOK_VERIFY_TOKEN=xxx_generate_with_openssl_rand_hex_32_xxx
META_APP_SECRET=xxx_your_meta_app_secret_xxx
