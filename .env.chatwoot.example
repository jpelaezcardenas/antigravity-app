# Chatwoot local infrastructure secrets (docker-compose.chatwoot.yml).
# Copy to .env.chatwoot (gitignored — never commit real values) and fill in.
#
# Usage: docker compose --env-file .env.chatwoot -f docker-compose.chatwoot.yml up -d

# Any strong password — this Postgres is only reachable from other containers
# on this compose project's internal network, never exposed on a host port.
CHATWOOT_DB_PASSWORD=

# Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=

# Host port Chatwoot's web UI/API listens on (design.md decision 8 port plan —
# avoids :3000, already used by Next.js dev / Hermes Workspace UI).
CHATWOOT_PORT=3020
